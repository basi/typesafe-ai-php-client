{
    "name": "basi/typesafe-ai-php-client",
    "type": "library",
    "description": "PHP client for the typesafe.ai System One API (Jev)",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "php-http/discovery": "^1.20"
    },
    "require-dev": {
        "phpunit/phpunit": "^12",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "TypesafeAi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TypesafeAi\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "spec:fetch": "tools/fetch-spec.sh spec",
        "spec:check": "tools/fetch-spec.sh build/spec && diff -u spec/openapi.normalized.json build/spec/openapi.normalized.json"
    }
}
